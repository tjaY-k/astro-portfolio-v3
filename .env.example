# Copy this file to .env and fill in the values.

# Formspree form ID — the part after /f/ in your endpoint URL.
# Create a form at https://formspree.io, then copy the ID from
# the endpoint it gives you (e.g. https://formspree.io/f/abcdwxyz -> abcdwxyz).
# This value is public: it is visible in the contact form's network request.
FORMSPREE_FORM_ID=your_formspree_form_id_here

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Leave empty to disable.
GTM_ID=your_google_tag_manager_id_here
