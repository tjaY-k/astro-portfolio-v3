<div
  class='pointer-events-none fixed bottom-0 left-0 right-0 top-0 print:hidden'
  style='mask-image: radial-gradient(circle, transparent, black); -webkit-mask-image: radial-gradient(circle, transparent, black);'
>
  <canvas id='artPlumCanvas' width='400' height='400'></canvas>
</div>

<script>
  // Particle Network v4: низкий контраст + огромный неоновый KL (как в PSD) + супер-плавная анимация
  const canvas = document.getElementById('artPlumCanvas') as HTMLCanvasElement;
  let ctx: CanvasRenderingContext2D;
  let particles: Array<{ x: number; y: number; vx: number; vy: number; radius: number; targetX?: number; targetY?: number }> = [];
  let animationFrameId: number;
  let shapeTargets: Array<{ x: number; y: number }> = [];
  let forming = false;
  let lastFormTime = Date.now();

  const NUM_PARTICLES = 160;
  const CONNECT_DISTANCE = 130;
  const BASE_COLOR = '#88888828';           // ← сильно снижен контраст (очень мягкий)
  const NEON_COLOR = '#00f0ff55';           // ← неоновый cyan как в PSD
  const SPEED = 0.22;
  const FORM_INTERVAL = 28000;
  const FORM_DURATION = 12000;

  function resizeCanvas() {
    const dpr = window.devicePixelRatio || 1;
    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;
    canvas.style.width = `${window.innerWidth}px`;
    canvas.style.height = `${window.innerHeight}px`;
    ctx.scale(dpr, dpr);
  }

  function createShapeTargets() {
    const offscreen = document.createElement('canvas');
    offscreen.width = 1200;                  // ← увеличено
    offscreen.height = 600;                  // ← увеличено
    const oCtx = offscreen.getContext('2d')!;
    oCtx.fillStyle = '#ffffff';
    oCtx.font = 'bold 420px Arial';          // ← значительно крупнее
    oCtx.textAlign = 'center';
    oCtx.textBaseline = 'middle';
    oCtx.fillText('KL', 600, 320);           // ← центрировано под новый размер

    const imageData = oCtx.getImageData(0, 0, 1200, 600).data;
    shapeTargets = [];
    for (let y = 0; y < 600; y += 7) {
      for (let x = 0; x < 1200; x += 7) {
        const i = (y * 1200 + x) * 4;
        if (imageData[i + 3] > 128) {
          shapeTargets.push({
            x: (x / 1200) * window.innerWidth,
            y: (y / 600) * window.innerHeight,
          });
        }
      }
    }
  }

  function createParticles() {
    particles = [];
    for (let i = 0; i < NUM_PARTICLES; i++) {
      particles.push({
        x: Math.random() * window.innerWidth,
        y: Math.random() * window.innerHeight,
        vx: (Math.random() - 0.5) * SPEED,
        vy: (Math.random() - 0.5) * SPEED,
        radius: Math.random() * 2.4 + 0.9,
      });
    }
  }

  function draw() {
    const width = window.innerWidth;
    const height = window.innerHeight;
    const now = Date.now();

    if (now - lastFormTime > FORM_INTERVAL) {
      forming = true;
      lastFormTime = now;
    }
    if (forming && now - lastFormTime > FORM_DURATION) {
      forming = false;
      lastFormTime = now;
    }

    ctx.clearRect(0, 0, width, height);
    ctx.shadowBlur = 0;

    // Обновление частиц
    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];

      if (forming && shapeTargets.length > 0) {
        const target = shapeTargets[i % shapeTargets.length];
        p.targetX = target.x;
        p.targetY = target.y;
        const dx = p.targetX - p.x;
        const dy = p.targetY - p.y;

        // СУПЕР-ПЛАВНОЕ притяжение (намного мягче чем раньше)
        p.vx += dx * 0.014;
        p.vy += dy * 0.014;
        p.vx *= 0.935;
        p.vy *= 0.935;
      } else {
        p.vx += (Math.random() - 0.5) * 0.25;
        p.vy += (Math.random() - 0.5) * 0.25;
        p.vx *= 0.96;
        p.vy *= 0.96;
        delete p.targetX;
        delete p.targetY;
      }

      p.x += p.vx;
      p.y += p.vy;

      if (p.x < 0 || p.x > width) p.vx *= -1;
      if (p.y < 0 || p.y > height) p.vy *= -1;

      // Рисуем точки (разный цвет + glow только в режиме KL)
      if (forming) {
        ctx.shadowBlur = 18;
        ctx.shadowColor = '#00f0ff';
        ctx.fillStyle = NEON_COLOR;
      } else {
        ctx.shadowBlur = 0;
        ctx.fillStyle = BASE_COLOR;
      }
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      ctx.fill();
    }

    // Соединяющие линии (низкий контраст)
    ctx.shadowBlur = forming ? 12 : 0;
    ctx.shadowColor = '#00f0ff';
    ctx.strokeStyle = forming ? NEON_COLOR : BASE_COLOR;
    ctx.lineWidth = 0.9;
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const p1 = particles[i];
        const p2 = particles[j];
        const dx = p1.x - p2.x;
        const dy = p1.y - p2.y;
        const dist = Math.hypot(dx, dy);

        if (dist < CONNECT_DISTANCE) {
          ctx.globalAlpha = (1 - dist / CONNECT_DISTANCE) * (forming ? 0.45 : 0.28);
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.stroke();
        }
      }
    }
    ctx.globalAlpha = 1;
    ctx.shadowBlur = 0;

    animationFrameId = requestAnimationFrame(draw);
  }

  function init() {
    const tempCtx = canvas.getContext('2d');
    if (!tempCtx) return;
    ctx = tempCtx;

    resizeCanvas();
    createShapeTargets();
    createParticles();
    draw();

    window.addEventListener('resize', () => {
      resizeCanvas();
      createShapeTargets();
      createParticles();
    });
  }

  init();
</script>