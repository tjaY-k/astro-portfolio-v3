<button
  class='theme-toggle p-2 rounded-md flex items-center justify-center hover:bg-accent transition-colors relative'
  aria-label='Toggle theme'
>
  <svg
    class='w-5 h-5 rotate-0 scale-100 transition-all dark:rotate-90 dark:scale-0'
    fill='none'
    viewBox='0 0 24 24'
    stroke='currentColor'
  >
    <path
      stroke-linecap='round'
      stroke-linejoin='round'
      stroke-width='2'
      d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
    ></path>
  </svg>
  <svg
    class='absolute w-5 h-5 rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100'
    fill='none'
    viewBox='0 0 24 24'
    stroke='currentColor'
  >
    <path
      stroke-linecap='round'
      stroke-linejoin='round'
      stroke-width='2'
      d='M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z'
    ></path>
  </svg>
</button>

<script>
  type Theme = 'light' | 'dark';

  const systemTheme = (): Theme =>
    window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

  const getTheme = (): Theme => {
    const stored = localStorage.getItem('theme');
    // 'retro' больше не существует — у вернувшихся посетителей оно ещё лежит
    // в localStorage, поэтому всё, кроме light/dark, откатываем на системную.
    return stored === 'light' || stored === 'dark' ? stored : systemTheme();
  };

  const setTheme = (theme: Theme) => {
    document.documentElement.classList.remove('light', 'dark', 'retro');
    document.documentElement.classList.add(theme);
    localStorage.setItem('theme', theme);
  };

  const toggleTheme = () => setTheme(getTheme() === 'dark' ? 'light' : 'dark');

  function initThemeToggle() {
    document
      .querySelectorAll('.theme-toggle')
      .forEach((toggle) => toggle.addEventListener('click', toggleTheme));
    setTheme(getTheme());
  }

  initThemeToggle();

  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
