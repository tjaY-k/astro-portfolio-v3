---
import { ArrowIcon } from '@/components/ui/icons';
import EmailIcon from '@/components/ui/icons/EmailIcon.astro';
import LinkedInIcon from '@/components/ui/icons/LinkedInIcon.astro';
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config';

const lookingForOptions = [
  { value: 'projection-mapping', label: 'Projection Mapping Project' },
  { value: 'media-server-programming', label: 'Media Server Programming (disguise / Pixera)' },
  { value: 'xr-led-setup', label: 'xR / LED Wall Setup' },
  { value: 'technical-consulting', label: 'Technical Consulting for Events' },
  { value: 'festival-production', label: 'Festival / Large Event Production' },
  { value: 'collaboration', label: 'Collaboration / Partnership' },
  { value: 'other', label: 'Something Else' },
];

const budgetOptions = [
  { value: 'under-10k', label: 'Under $10k' },
  { value: '10k-50k', label: '$10k - $50k' },
  { value: '50k-100k', label: '$50k - $100k' },
  { value: '100k-plus', label: '$100k+' },
];

const contactMethods = [
  {
    icon: EmailIcon,
    label: 'Email',
    value: siteConfig.email,
    href: `mailto:${siteConfig.email}`,
  },
  {
    icon: LinkedInIcon,
    label: 'LinkedIn',
    value: 'konstantin-laptev-72b70595',
    href: 'https://linkedin.com/in/konstantin-laptev-72b70595',
    external: true,
  },
];
---

<Layout
  title='Contact – Konstantin Laptev'
  description='Get in touch with Konstantin Laptev — Video Technical Manager & Senior disguise Operator — for projection mapping, media server projects, xR setups and large-scale live events.'
  ogTitle='Contact Konstantin Laptev'
  ogDescription='Projection mapping • Media servers • xR • Large-scale events in Dubai & worldwide'
>
  <!-- Calendly Script -->
  <script
    type='text/javascript'
    src='https://assets.calendly.com/assets/external/widget.js'
    async></script>

  <div class='container-fluid py-16 md:py-20'>
    <div class='mb-16 text-center space-y-4'>
      <div class='inline-block'>
        <span
          class='text-xs uppercase tracking-wider text-primary font-semibold px-4 py-2 rounded-full bg-primary/10 border border-primary/20'
        >
          Let's Connect
        </span>
      </div>
      <h1
        class='text-3xl md:text-4xl font-semibold text-foreground leading-tight tracking-tight first-letter-color'
      >
        Start a Conversation
      </h1>
      <p class='text-lg text-muted-foreground max-w-3xl mx-auto'>
        I'm always open to conversations about large-scale live production, projection mapping, disguise / Pixera programming, xR technologies and immersive events. 
        If you have a project in Dubai, Riyadh, or anywhere in the world — feel free to reach out.
      </p>
    </div>

    <!-- Tabs Navigation -->
    <div class='flex justify-center mb-8'>
      <div
        class='inline-flex gap-2 p-1 rounded-lg bg-secondary/20 border border-border'
      >
        <button
          id='form-tab-btn'
          class='tab-button active px-6 py-3 rounded-md text-sm font-medium transition-all'
        >
          Contact Form
        </button>
        <button
          id='calendly-tab-btn'
          class='tab-button px-6 py-3 rounded-md text-sm font-medium transition-all'
        >
          Schedule a Call
        </button>
      </div>
    </div>

    <div id='form-tab' class='tab-content'>
      <div class='grid lg:grid-cols-5 gap-8'>
        <div class='lg:col-span-3'>
          <form id='contact-form' class='space-y-8 h-full'>
            <div class='grid md:grid-cols-2 gap-6'>
              <div class='flex flex-col gap-2'>
                <label for='name' class='text-sm font-medium text-foreground'>
                  My Name is <span class='text-destructive'>*</span>
                </label>
                <input
                  type='text'
                  id='name'
                  name='name'
                  required
                  placeholder='Your name'
                  class='w-full px-4 py-3 rounded-lg border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-muted-foreground'
                />
              </div>

              <div class='flex flex-col gap-2'>
                <label
                  for='company'
                  class='text-sm font-medium text-foreground'
                >
                  I work at
                </label>
                <input
                  type='text'
                  id='company'
                  name='company'
                  placeholder='Company / Event Organizer'
                  class='w-full px-4 py-3 rounded-lg border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-muted-foreground'
                />
              </div>
            </div>

            <div class='flex flex-col gap-2'>
              <label for='email' class='text-sm font-medium text-foreground'>
                My Email is <span class='text-destructive'>*</span>
              </label>
              <input
                type='email'
                id='email'
                name='email'
                required
                placeholder='your.email@example.com'
                class='w-full px-4 py-3 rounded-lg border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-muted-foreground'
              />
            </div>

            <div class='space-y-3'>
              <label class='text-sm font-medium text-foreground block'>
                I'm looking for? <span class='text-destructive'>*</span>
              </label>
              <div class='grid sm:grid-cols-2 gap-3'>
                {
                  lookingForOptions.map((option) => (
                    <label class='flex items-center gap-3 p-4 rounded-lg border border-border bg-background hover:border-primary/50 cursor-pointer transition-all group'>
                      <input
                        type='checkbox'
                        name='looking_for'
                        value={option.value}
                        class='appearance-none w-5 h-5 rounded border-2 border-border bg-background cursor-pointer transition-all checked:bg-primary checked:border-primary relative flex items-center justify-center before:content-[""] before:absolute before:w-2.5 before:h-1.5 before:border-l-2 before:border-b-2 before:border-primary-foreground before:-rotate-45 before:-translate-y-px before:opacity-0 checked:before:opacity-100'
                      />
                      <span class='text-sm text-foreground group-hover:text-primary transition-colors'>
                        {option.label}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <div class='space-y-3'>
              <label class='text-sm font-medium text-foreground block'>
                My budget range is (Optional)
              </label>
              <div class='grid sm:grid-cols-2 gap-3'>
                {
                  budgetOptions.map((option) => (
                    <label class='flex items-center gap-3 p-4 rounded-lg border border-border bg-background hover:border-primary/50 cursor-pointer transition-all group'>
                      <input
                        type='radio'
                        name='budget'
                        value={option.value}
                        class='appearance-none w-5 h-5 rounded-full border-2 border-border bg-background cursor-pointer transition-all checked:border-primary checked:border-[6px] '
                      />
                      <span class='text-sm text-foreground group-hover:text-primary transition-colors'>
                        {option.label}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <div class='flex flex-col gap-2'>
              <label for='message' class='text-sm font-medium text-foreground'>
                More details about the project (brief summary, deadline etc) <span
                  class='text-destructive'>*</span
                >
              </label>
              <textarea
                id='message'
                name='message'
                required
                rows='6'
                placeholder='Tell me about your event, projection mapping needs, media server requirements, dates, location...'
                class='w-full px-4 py-3 rounded-lg border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-muted-foreground resize-y'
              ></textarea>
            </div>

            <button
              type='submit'
              class='w-full md:w-auto px-8 py-4 bg-primary text-primary-foreground rounded-xl font-medium flex items-center justify-center gap-2 hover:bg-primary/90 transition-colors'
            >
              Send Message
              <ArrowIcon class='w-4 h-4' />
            </button>
          </form>
        </div>

        <!-- Sidebar -->
        <div class='lg:col-span-2 space-y-8'>
          <div class='bg-background border border-border rounded-3xl p-8'>
            <h3 class='font-semibold text-lg mb-6'>Direct Contact</h3>
            <div class='space-y-6'>
              {
                contactMethods.map((method) => (
                  <a
                    href={method.href}
                    target={method.external ? '_blank' : undefined}
                    class='flex items-start gap-4 group'
                  >
                    <div class='mt-1'>
                      <method.icon class='w-6 h-6 text-muted-foreground group-hover:text-primary transition-colors' />
                    </div>
                    <div>
                      <div class='text-sm font-medium text-foreground'>{method.label}</div>
                      <div class='text-foreground/70 text-base'>{method.value}</div>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>

          <div class='text-sm text-muted-foreground'>
            I respond to every message personally within 24 hours.
          </div>
        </div>
      </div>
    </div>

    <!-- Calendly tab -->
    <div id='calendly-tab' class='tab-content hidden'>
      <div class='calendly-inline-widget' data-url='https://calendly.com/lewis-kihiu/30min' style='min-width:320px;height:700px;'></div>
    </div>
  </div>

  <script>
    // Tab switching logic
    const formTabBtn = document.getElementById('form-tab-btn');
    const calendlyTabBtn = document.getElementById('calendly-tab-btn');
    const formTab = document.getElementById('form-tab');
    const calendlyTab = document.getElementById('calendly-tab');

    formTabBtn.addEventListener('click', () => {
      formTab.classList.remove('hidden');
      calendlyTab.classList.add('hidden');
      formTabBtn.classList.add('active');
      calendlyTabBtn.classList.remove('active');
    });

    calendlyTabBtn.addEventListener('click', () => {
      formTab.classList.add('hidden');
      calendlyTab.classList.remove('hidden');
      formTabBtn.classList.remove('active');
      calendlyTabBtn.classList.add('active');
    });

    // Form submission (simple alert for demo)
    const form = document.getElementById('contact-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Thank you! Your message has been sent. I will reply within 24 hours.');
        form.reset();
      });
    }
  </script>
</Layout>