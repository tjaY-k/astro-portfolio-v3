---
import { ArrowIcon } from '@/components/ui/icons';
import EmailIcon from '@/components/ui/icons/EmailIcon.astro';
import LinkedInIcon from '@/components/ui/icons/LinkedInIcon.astro';
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config';
import { FORMSPREE_FORM_ID } from 'astro:env/client';

const lookingForOptions = [
  { value: 'projection-mapping', label: 'Projection Mapping Project' },
  { value: 'media-server-programming', label: 'Media Server Programming (disguise / Pixera)' },
  { value: 'xr-led-setup', label: 'xR / LED Wall Setup' },
  { value: 'technical-consulting', label: 'Technical Consulting for Events' },
  { value: 'festival-production', label: 'Festival / Large Event Production' },
  { value: 'collaboration', label: 'Collaboration / Partnership' },
  { value: 'other', label: 'Something Else' },
];

const contactMethods = [
  {
    icon: EmailIcon,
    label: 'Email',
    value: siteConfig.email,
    href: `mailto:${siteConfig.email}`,
  },
  {
    icon: LinkedInIcon,
    label: 'LinkedIn',
    value: 'konstantin-laptev-dxb',
    href: 'https://www.linkedin.com/in/konstantin-laptev-dxb',
    external: true,
  },
];
---

<Layout
  title='Contact – Konstantin Laptev'
  description='Get in touch with Konstantin Laptev — Video Technical Manager and Senior disguise Operator — for projection mapping, media server programming, xR builds and large-scale live events.'
  ogTitle='Contact Konstantin Laptev'
  ogDescription='Projection mapping, media servers and xR for large-scale live events — Dubai and worldwide.'
>
  <!-- Calendly Script -->
  <script
    type='text/javascript'
    src='https://assets.calendly.com/assets/external/widget.js'
    async></script>

  <div class='container-fluid py-16 md:py-20'>
    <div class='mb-16 text-center space-y-4'>
      <div class='inline-block'>
        <span
          class='text-xs uppercase tracking-wider text-primary font-semibold px-4 py-2 rounded-full bg-primary/10 border border-primary/20'
        >
          Contact
        </span>
      </div>
      <h1
        class='text-3xl md:text-4xl font-semibold text-foreground leading-tight tracking-tight first-letter-color'
      >
        Start a Conversation
      </h1>
      <p class='text-lg text-muted-foreground max-w-3xl mx-auto'>
        A projection study, a media server package, an xR build or a full site-wide video system —
        tell me the venue, the dates and what the audience should see, and I'll come back with what it takes.
        Based in Dubai, working worldwide.
      </p>
    </div>

    <!-- Tabs Navigation -->
    <div class='flex justify-center mb-8'>
      <div
        class='inline-flex gap-2 p-1 rounded-lg bg-secondary/20 border border-border'
      >
        <button
          id='form-tab-btn'
          class='tab-button active px-6 py-3 rounded-md text-sm font-medium transition-all'
        >
          Contact Form
        </button>
        <button
          id='calendly-tab-btn'
          class='tab-button px-6 py-3 rounded-md text-sm font-medium transition-all'
        >
          Schedule a Call
        </button>
      </div>
    </div>

    <div id='form-tab' class='tab-content'>
      <div class='grid lg:grid-cols-5 gap-8'>
        <div class='lg:col-span-3'>
          <form
            id='contact-form'
            class='space-y-8 h-full'
            data-formspree-id={FORMSPREE_FORM_ID}
            data-fallback-email={siteConfig.email}
          >
            <div class='grid md:grid-cols-2 gap-6'>
              <div class='flex flex-col gap-2'>
                <label for='name' class='text-sm font-medium text-foreground'>
                  My name is <span class='text-destructive'>*</span>
                </label>
                <input
                  type='text'
                  id='name'
                  name='name'
                  required
                  placeholder='Your name'
                  class='w-full px-4 py-3 rounded-lg border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-muted-foreground'
                />
              </div>

              <div class='flex flex-col gap-2'>
                <label
                  for='company'
                  class='text-sm font-medium text-foreground'
                >
                  I work at
                </label>
                <input
                  type='text'
                  id='company'
                  name='company'
                  placeholder='Company / Event Organizer'
                  class='w-full px-4 py-3 rounded-lg border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-muted-foreground'
                />
              </div>
            </div>

            <div class='flex flex-col gap-2'>
              <label for='email' class='text-sm font-medium text-foreground'>
                My email is <span class='text-destructive'>*</span>
              </label>
              <input
                type='email'
                id='email'
                name='email'
                required
                placeholder='your.email@example.com'
                class='w-full px-4 py-3 rounded-lg border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-muted-foreground'
              />
            </div>

            <div class='space-y-3'>
              <label class='text-sm font-medium text-foreground block'>
                I'm looking for <span class='text-destructive'>*</span>
              </label>
              <div class='grid sm:grid-cols-2 gap-3'>
                {
                  lookingForOptions.map((option) => (
                    <label class='flex items-center gap-3 p-4 rounded-lg border border-border bg-background hover:border-primary/50 cursor-pointer transition-all group'>
                      <input
                        type='checkbox'
                        name='looking_for'
                        value={option.value}
                        class='appearance-none w-5 h-5 rounded border-2 border-border bg-background cursor-pointer transition-all checked:bg-primary checked:border-primary relative flex items-center justify-center before:content-[""] before:absolute before:w-2.5 before:h-1.5 before:border-l-2 before:border-b-2 before:border-primary-foreground before:-rotate-45 before:-translate-y-px before:opacity-0 checked:before:opacity-100'
                      />
                      <span class='text-sm text-foreground group-hover:text-primary transition-colors'>
                        {option.label}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <div class='flex flex-col gap-2'>
              <label for='message' class='text-sm font-medium text-foreground'>
                About the project — scope, venue, dates <span
                  class='text-destructive'>*</span
                >
              </label>
              <textarea
                id='message'
                name='message'
                required
                rows='6'
                placeholder='What are we projecting onto, how big is the site, when does it load in, and what has to happen on show night?'
                class='w-full px-4 py-3 rounded-lg border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all placeholder:text-muted-foreground resize-y'
              ></textarea>
            </div>

            <!-- Honeypot: hidden from people, tempting to bots. Formspree drops anything that fills it. -->
            <div class='hidden' aria-hidden='true'>
              <label for='_gotcha'>Leave this field empty</label>
              <input type='text' id='_gotcha' name='_gotcha' tabindex='-1' autocomplete='off' />
            </div>

            <div class='flex flex-col gap-4'>
              <button
                type='submit'
                id='submit-button'
                class='w-full md:w-auto px-8 py-4 bg-primary text-primary-foreground rounded-xl font-medium flex items-center justify-center gap-2 hover:bg-primary/90 transition-colors disabled:opacity-60 disabled:cursor-not-allowed'
              >
                <span id='submit-label'>Send Message</span>
                <ArrowIcon class='w-4 h-4' />
              </button>

              <p
                id='form-status'
                role='status'
                aria-live='polite'
                class='hidden text-sm rounded-lg px-4 py-3 border'
              >
              </p>
            </div>
          </form>
        </div>

        <!-- Sidebar -->
        <div class='lg:col-span-2 space-y-8'>
          <div class='bg-background border border-border rounded-3xl p-8'>
            <h3 class='font-semibold text-lg mb-6'>Direct Contact</h3>
            <div class='space-y-6'>
              {
                contactMethods.map((method) => (
                  <a
                    href={method.href}
                    target={method.external ? '_blank' : undefined}
                    class='flex items-start gap-4 group'
                  >
                    <div class='mt-1'>
                      <method.icon class='w-6 h-6 text-muted-foreground group-hover:text-primary transition-colors' />
                    </div>
                    <div>
                      <div class='text-sm font-medium text-foreground'>{method.label}</div>
                      <div class='text-foreground/70 text-base'>{method.value}</div>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>

          <div class='text-sm text-muted-foreground'>
            I respond to every message personally within 24 hours.
          </div>
        </div>
      </div>
    </div>

    <!-- Calendly tab -->
    <div id='calendly-tab' class='tab-content hidden'>
      <div class='calendly-inline-widget' data-url='https://calendly.com/kslaptev/30min' style='min-width:320px;height:700px;'></div>
    </div>
  </div>

  <script>
    const SUCCESS_CLASSES = ['bg-primary/10', 'border-primary/30', 'text-foreground'];
    const ERROR_CLASSES = ['bg-destructive/10', 'border-destructive/30', 'text-destructive'];

    function initContactPage() {
      const formTabBtn = document.getElementById('form-tab-btn');
      const calendlyTabBtn = document.getElementById('calendly-tab-btn');
      const formTab = document.getElementById('form-tab');
      const calendlyTab = document.getElementById('calendly-tab');

      if (formTabBtn && calendlyTabBtn && formTab && calendlyTab) {
        formTabBtn.addEventListener('click', () => {
          formTab.classList.remove('hidden');
          calendlyTab.classList.add('hidden');
          formTabBtn.classList.add('active');
          calendlyTabBtn.classList.remove('active');
        });

        calendlyTabBtn.addEventListener('click', () => {
          formTab.classList.add('hidden');
          calendlyTab.classList.remove('hidden');
          formTabBtn.classList.remove('active');
          calendlyTabBtn.classList.add('active');
        });
      }

      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const status = document.getElementById('form-status');
      const button = document.getElementById('submit-button') as HTMLButtonElement | null;
      const label = document.getElementById('submit-label');

      if (!form || !status || !button || !label) return;
      // Guard against double-binding when the View Transitions router re-runs this.
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      function showStatus(message: string, ok: boolean) {
        status!.textContent = message;
        status!.classList.remove('hidden', ...SUCCESS_CLASSES, ...ERROR_CLASSES);
        status!.classList.add(...(ok ? SUCCESS_CLASSES : ERROR_CLASSES));
      }

      function setBusy(busy: boolean) {
        button!.disabled = busy;
        label!.textContent = busy ? 'Sending…' : 'Send Message';
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        // Read these per submit, not once at init: the router can swap the form element.
        const formId = form.dataset.formspreeId || '';
        const fallbackEmail = form.dataset.fallbackEmail || '';

        // The asterisk on "I'm looking for" promises this is required,
        // but a checkbox group cannot enforce it natively.
        const checked = form.querySelectorAll('input[name="looking_for"]:checked');
        if (checked.length === 0) {
          showStatus('Please pick at least one option under “I’m looking for”.', false);
          return;
        }

        if (!formId) {
          showStatus(
            `The form isn’t connected yet. Please email me directly at ${fallbackEmail}.`,
            false,
          );
          return;
        }

        setBusy(true);

        try {
          const response = await fetch(`https://formspree.io/f/${formId}`, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (response.ok) {
            form.reset();
            showStatus(
              'Thanks — your message is on its way. I’ll get back to you within 24 hours.',
              true,
            );
          } else {
            const data = await response.json().catch(() => null);
            const detail = data?.errors?.map((e: { message: string }) => e.message).join(' ');
            showStatus(
              detail || `Something went wrong sending that. Please email me at ${fallbackEmail}.`,
              false,
            );
          }
        } catch {
          showStatus(
            `Couldn’t reach the server — check your connection, or email me at ${fallbackEmail}.`,
            false,
          );
        } finally {
          setBusy(false);
        }
      });
    }

    initContactPage();
    document.addEventListener('astro:page-load', initContactPage);
  </script>
</Layout>