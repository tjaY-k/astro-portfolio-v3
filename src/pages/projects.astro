---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

// Sort by year (descending)
const sortedProjects = allProjects.sort((a, b) => b.data.year - a.data.year);
---

<Layout
  title='Projects – Konstantin Laptev'
  description='Large-scale live production, projection mapping, media server programming and immersive events'
  ogTitle="Featured Projects"
  ogDescription='Selected large-scale live production and immersive visual projects'
>
  <div class='container-fluid py-8 md:py-16'>
    <!-- Header -->
    <div class='mb-10'>
      <h1 class='text-4xl md:text-5xl font-semibold tracking-tight mb-3'>Featured Projects</h1>
      <p class='text-lg text-muted-foreground max-w-2xl'>
        Selected large-scale live production, projection mapping and immersive visual experiences.
      </p>
    </div>

    <!-- Projects Grid (Card Layout) -->
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6' id='projects-grid'>
      {
        sortedProjects.map((project) => (
          <div 
            class='group project-card border border-border rounded-2xl overflow-hidden bg-card hover:border-primary/50 hover:shadow-xl transition-all duration-200 cursor-pointer flex flex-col'
            data-project-id={project.id}
          >
            <!-- Cover Image -->
            {project.data.cover_image && (
              <div class='aspect-video overflow-hidden bg-muted'>
                <img 
                  src={project.data.cover_image} 
                  alt={project.data.title}
                  class='w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300'
                />
              </div>
            )}

            <div class='p-6 flex flex-col flex-1'>
              <div class='flex items-start justify-between gap-4 mb-3'>
                <h3 class='font-semibold text-xl leading-tight group-hover:text-primary transition-colors'>
                  {project.data.title}
                </h3>
                <span class='text-sm text-muted-foreground font-mono shrink-0 mt-0.5'>
                  {project.data.year}
                </span>
              </div>

              <p class='text-muted-foreground text-sm line-clamp-3 mb-5 flex-1'>
                {project.data.description}
              </p>

              <!-- Tech Tags -->
              {project.data.tech?.length > 0 && (
                <div class='flex flex-wrap gap-2 mt-auto pt-2'>
                  {project.data.tech.slice(0, 5).map((tech) => (
                    <span class='text-xs px-3 py-1 rounded-full bg-secondary/20 text-foreground'>
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- DUMMY BLOCK for Tailwind -->
  <div class="hidden">
    <div class="p-0 rounded-2xl bg-card border border-border/50 shadow-2xl">
      <img class="w-full rounded-t-2xl" />
      <div class="p-8">
        <h2 class="text-3xl font-semibold mb-2"></h2>
        <p class="text-muted-foreground mb-6"></p>
        <div class="prose prose-invert max-w-none"></div>
        <div class="mt-8">
          <h3 class="text-sm font-semibold mb-3 text-muted-foreground">Tech Stack</h3>
          <div class="flex flex-wrap gap-2">
            <span class="text-xs px-3 py-1 bg-secondary/20 rounded-full text-foreground"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Project Modal -->
  <dialog id='project-modal' class='backdrop:bg-background/80 backdrop:backdrop-blur-sm bg-card border border-border/50 rounded-2xl max-w-3xl w-full p-0 shadow-2xl m-auto'>
    <div class='relative max-h-[90vh] overflow-y-auto project-modal-content' id='modal-content'></div>
  </dialog>

  <!-- Video Modal -->
  <dialog id="videoModalHome" class="backdrop:bg-black/90 bg-black rounded-2xl max-w-4xl w-full p-0 shadow-2xl m-auto hidden">
    <div class="flex justify-end p-4 border-b border-white/10">
      <button id="closeVideoHome" class="text-white/70 hover:text-white">×</button>
    </div>
    <div class="aspect-video bg-black">
      <iframe id="videoFrameHome" class="w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
  </dialog>

  <script define:vars={{ sortedProjects }}>
    const projectsData = sortedProjects.map(p => ({
      id: p.id,
      title: p.data.title,
      made_at: p.data.made_at,
      location: p.data.location,
      year: p.data.year,
      tech: p.data.tech || [],
      cover_image: p.data.cover_image,
      external_link: p.data.external_link,
      github_link: p.data.github_link,
      app_store: p.data.app_store,
      google_play: p.data.google_play,
      video_url: p.data.video_url,
      body: p.body
    }));

    function initProjectModals() {
      const modal = document.getElementById('project-modal');
      const modalContent = document.getElementById('modal-content');
      const cards = document.querySelectorAll('.project-card');

      // Open project modal on card click (same rich assembly as homepage)
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const projectId = card.dataset.projectId;
          const project = projectsData.find(p => p.id === projectId);
          if (!project) return;

          const linksHtml = `
            <div class="flex flex-wrap gap-3">
              ${
                project.external_link
                  ? `
                <a href="${project.external_link}" target="_blank" rel="noopener noreferrer" 
                  class="inline-flex items-center gap-2 px-5 text-sm py-2.5 bg-primary text-background rounded-md font-medium hover:bg-primary/90 transition-all">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                  </svg>
                  Visit Website
                </a>
              `
                  : ''
              }
              ${
                project.github_link
                  ? `
                <a href="${project.github_link}" target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-6 py-3 border border-foreground text-foreground rounded-md font-medium hover:bg-foreground hover:text-background transition-all">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
              `
                  : ''
              }
              ${
                project.app_store
                  ? `
                <a href="${project.app_store}" target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 text-sm py-2.5 border border-primary text-primary rounded-md font-medium hover:bg-primary hover:text-background transition-all">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                  </svg>
                  App Store
                </a>
              `
                  : ''
              }
              ${
                project.google_play
                  ? `
                <a href="${project.google_play}" target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 text-sm py-2.5 border border-secondary text-secondary rounded-md font-medium hover:bg-secondary hover:text-background transition-all">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/>
                  </svg>
                  Play Store
                </a>
              `
                  : ''
              }
              ${
                project.video_url
                  ? `
                <button 
                  class="inline-flex items-center gap-2 px-5 text-sm py-2.5 border border-secondary text-secondary rounded-md font-medium hover:bg-secondary hover:text-background transition-all video-btn" 
                  data-video-url="${project.video_url}">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9" />
                  </svg>
                  Watch Video
                </button>
              `
                  : ''
              }
            </div>
          `;

          modalContent.innerHTML = `
            <button onclick="document.getElementById('project-modal').close()" 
              class="absolute top-4 right-4 z-10 p-2 rounded-full bg-background/80 backdrop-blur-sm border border-border hover:bg-muted transition-colors">
              <svg class="w-6 h-6 text-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>

            ${
              project.cover_image
                ? `<div class="aspect-[16/9] overflow-hidden">
                     <img src="${project.cover_image}" alt="${project.title}" 
                       class="w-full h-full object-cover" />
                   </div>`
                : ''
            }

            <div class="p-8 space-y-6">
              <div>
                <h2 class="text-4xl font-bold text-foreground mb-2">${project.title}</h2>
                ${project.made_at ? `<p class="text-muted-foreground mb-4">Made at ${project.made_at} • ${project.year}</p>` : ''}
                <div class="text-muted-foreground text-lg leading-relaxed prose prose-lg dark:prose-invert max-w-none">
                  ${project.body}
                </div>
              </div>

              <div>
                <h3 class="text-xl font-bold text-foreground mb-3">Tech Stack</h3>
                <div class="flex flex-wrap gap-2">
                  ${(project.tech || [])
                    .map(
                      (tech) =>
                        `<span class="px-3.5 py-1.5 bg-primary/10 text-primary rounded-full text-xs font-medium border border-primary/20">${tech}</span>`,
                    )
                    .join('')}
                </div>
              </div>

              ${linksHtml}
            </div>
          `;
          modal.showModal();
        });
      });

      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.close();
      });

      // Video Modal handling (same as homepage)
      const videoModalHome = document.getElementById('videoModalHome');
      const videoFrameHome = document.getElementById('videoFrameHome');
      const closeVideoHome = document.getElementById('closeVideoHome');

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('.video-btn');
        if (btn) {
          e.stopImmediatePropagation();
          const url = btn.getAttribute('data-video-url');
          if (url) {
            videoFrameHome.src = url;
            videoModalHome.showModal();
            videoModalHome.classList.remove('hidden');
          }
        }
      });

      if (closeVideoHome) {
        closeVideoHome.addEventListener('click', () => {
          videoModalHome.close();
          videoModalHome.classList.add('hidden');
          videoFrameHome.src = '';
        });
      }

      if (videoModalHome) {
        videoModalHome.addEventListener('click', (e) => {
          if (e.target === videoModalHome) {
            closeVideoHome.click();
          }
        });
      }
    }

    // Run on initial full page load
    initProjectModals();

    // Re-run after View Transitions / client-side navigation (e.g. clicking the top menu link to /projects)
    document.addEventListener('astro:page-load', initProjectModals);
  </script>
</Layout>
