---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

// Sort by year (descending)
const sortedProjects = allProjects.sort((a, b) => b.data.year - a.data.year);
---

<Layout
  title='Projects – Konstantin Laptev'
  description='Large-scale live production, projection mapping, media server programming and immersive events'
  ogTitle="Featured Projects"
  ogDescription='Selected large-scale live production and immersive visual projects'
>
  <div class='container-fluid py-8 md:py-16'>
    <!-- Header -->
    <div class='mb-10'>
      <h1 class='text-4xl md:text-5xl font-semibold tracking-tight mb-3'>Featured Projects</h1>
      <p class='text-lg text-muted-foreground max-w-2xl'>
        Selected large-scale live production, projection mapping and immersive visual experiences.
      </p>
    </div>

    <!-- Projects Grid (Card Layout) -->
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6' id='projects-grid'>
      {
        sortedProjects.map((project) => (
          <div 
            class='group project-card border border-border rounded-2xl overflow-hidden bg-card hover:border-primary/50 hover:shadow-xl transition-all duration-200 cursor-pointer flex flex-col'
            data-project-id={project.id}
          >
            <!-- Cover Image -->
            {project.data.cover_image && (
              <div class='aspect-video overflow-hidden bg-muted'>
                <img 
                  src={project.data.cover_image} 
                  alt={project.data.title}
                  class='w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300'
                />
              </div>
            )}

            <div class='p-6 flex flex-col flex-1'>
              <div class='flex items-start justify-between gap-4 mb-3'>
                <h3 class='font-semibold text-xl leading-tight group-hover:text-primary transition-colors'>
                  {project.data.title}
                </h3>
                <span class='text-sm text-muted-foreground font-mono shrink-0 mt-0.5'>
                  {project.data.year}
                </span>
              </div>

              <p class='text-muted-foreground text-sm line-clamp-3 mb-5 flex-1'>
                {project.data.description}
              </p>

              <!-- Tech Tags -->
              {project.data.tech?.length > 0 && (
                <div class='flex flex-wrap gap-2 mt-auto pt-2'>
                  {project.data.tech.slice(0, 5).map((tech) => (
                    <span class='text-xs px-3 py-1 rounded-full bg-secondary/20 text-foreground'>
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- DUMMY BLOCK for Tailwind -->
  <div class="hidden">
    <div class="p-0 rounded-2xl bg-card border border-border/50 shadow-2xl">
      <img class="w-full rounded-t-2xl" />
      <div class="p-8">
        <h2 class="text-3xl font-semibold mb-2"></h2>
        <p class="text-muted-foreground mb-6"></p>
        <div class="prose prose-invert max-w-none"></div>
        <div class="mt-8">
          <h3 class="text-sm font-semibold mb-3 text-muted-foreground">Tech Stack</h3>
          <div class="flex flex-wrap gap-2">
            <span class="text-xs px-3 py-1 bg-secondary/20 rounded-full text-foreground"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Project Modal -->
  <dialog id='project-modal' class='backdrop:bg-background/80 backdrop:backdrop-blur-sm bg-card border border-border/50 rounded-2xl max-w-3xl w-full p-0 shadow-2xl m-auto'>
    <div class='relative max-h-[90vh] overflow-y-auto project-modal-content pb-8' id='modal-content'></div>
  </dialog>

  <!-- Video Modal -->
  <dialog id="videoModalHome" class="backdrop:bg-black/90 bg-black rounded-2xl max-w-4xl w-full p-0 shadow-2xl m-auto hidden">
    <div class="flex justify-end p-4">
      <button onclick="closeVideoModal()" class="text-white/70 hover:text-white text-3xl leading-none">&times;</button>
    </div>
    <div class="p-2" id="videoContainer"></div>
  </dialog>

  <script define:vars={{ sortedProjects }}>
    const projectsData = sortedProjects.map(p => ({
      id: p.id,
      title: p.data.title,
      made_at: p.data.made_at,
      location: p.data.location,
      year: p.data.year,
      tech: p.data.tech || [],
      cover_image: p.data.cover_image,
      external_link: p.data.external_link,
      video_url: p.data.video_url,
      body: p.body
    }));

    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('project-modal');
      const modalContent = document.getElementById('modal-content');
      const cards = document.querySelectorAll('.project-card');
      const videoModal = document.getElementById('videoModalHome');
      const videoContainer = document.getElementById('videoContainer');

      // Open project modal on card click
      cards.forEach(card => {
        card.addEventListener('click', () => {
          const projectId = card.dataset.projectId;
          const project = projectsData.find(p => p.id === projectId);
          if (!project) return;

          modalContent.innerHTML = `
            <div>
              ${project.cover_image ? `<img src="${project.cover_image}" class="w-full rounded-t-2xl aspect-video object-cover" alt="${project.title}">` : ''}
              <div class="p-8">
                <div class="flex justify-between items-start mb-4">
                  <h2 class="text-3xl font-semibold">${project.title}</h2>
                  <span class="text-sm text-muted-foreground font-mono">${project.year}</span>
                </div>

                <div class="prose prose-invert max-w-none mb-8">
                  ${project.body || project.description || ''}
                </div>

                ${project.tech?.length ? `
                  <div class="mb-8">
                    <h3 class="text-sm font-semibold mb-3 text-muted-foreground">Tech Stack</h3>
                    <div class="flex flex-wrap gap-2">
                      ${project.tech.map(t => `<span class="text-xs px-3 py-1 bg-secondary/20 rounded-full">${t}</span>`).join('')}
                    </div>
                  </div>` : ''}

                <div class="flex flex-wrap gap-3">
                  ${project.external_link ? `
                    <a href="${project.external_link}" target="_blank" 
                       class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black rounded-xl font-medium hover:bg-white/90 transition-colors">
                      Visit Website
                    </a>` : ''}
                  ${project.video_url ? `
                    <button onclick="openVideoModal('${project.video_url}')" 
                            class="inline-flex items-center gap-2 px-6 py-3 border border-white/30 hover:border-white/70 rounded-xl font-medium transition-colors">
                      Watch Video
                    </button>` : ''}
                </div>
              </div>
            </div>
          `;
          modal.showModal();
        });
      });

      modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
    });

    window.openVideoModal = function(url) {
      const videoModal = document.getElementById('videoModalHome');
      const container = document.getElementById('videoContainer');
      container.innerHTML = `<iframe width="100%" height="500" src="${url}" frameborder="0" allowfullscreen></iframe>`;
      videoModal.showModal();
    };

    window.closeVideoModal = function() {
      const videoModal = document.getElementById('videoModalHome');
      const container = document.getElementById('videoContainer');
      container.innerHTML = '';
      videoModal.close();
    };
  </script>
</Layout>
