---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/shared/SectionHeader.astro';
import ResourceItem from '@/components/shared/ResourceItem.astro';

const currentBooks = await getCollection('books');
const techStack = await getCollection('techStack');
const desktopSetup = await getCollection('desktopSetup');
---

<Layout
  title='Technical Arsenal – Konstantin Laptev'
  description='Media Servers (disguise, Pixera), Projection Mapping, Hardware & Broadcast Equipment and Pre-Production Tools. Live production for major international events.'
  ogTitle='Technical Arsenal – Konstantin Laptev'
  ogDescription='Professional toolkit of Video Technical Manager & disguise Certified Operator Konstantin Laptev.'
>
  <div class='relative'>
    <div class='container-fluid py-16 md:py-20 relative'>
      <div class='mb-20 text-center space-y-6'>
        <div class='inline-block'>
          <span
            class='text-xs uppercase tracking-widest text-primary font-bold px-4 py-2 rounded-full bg-primary/10 border border-primary/20 backdrop-blur-sm'
          >
            My Arsenal
          </span>
        </div>
        <h1
          class='text-3xl md:text-4xl font-semibold text-foreground leading-tight tracking-tight first-letter-color'
        >
          Technical Arsenal<br />
          <span class='text-secondary'>Media Server & Live Production</span>
        </h1>
        <p
          class='text-lg md:text-xl text-muted-foreground font-light max-w-3xl mx-auto leading-relaxed'
        >
          Delivering large-scale live productions, media server operations and projection mapping worldwide
        </p>
      </div>

      <section class='mb-32'>
        <SectionHeader title='Media Servers' subtitle='disguise • Pixera • Resolume • MadMapper' />
        <div class='grid md:grid-cols-2 gap-6 md:gap-12'>
          {currentBooks.map((book, index) => (
            <ResourceItem
              href={book.data.link}
              image={book.data.image}
              title={book.data.title}
              subtitle={book.data.author}
              description={book.data.description}
              linkText='Learn more'
              imageSize='medium'
              index={index}
            />
          ))}
        </div>
      </section>

      <section class='mb-32'>
        <SectionHeader title='Hardware & Broadcast Equipment' subtitle='Projectors • Vision Mixers • LED Processors • Broadcast Systems' />
        <div class='grid md:grid-cols-2 gap-6 md:gap-12'>
          {desktopSetup.map((item, index) => {
            const hideLink = item.id === 'broadcast-cameras' || item.id === 'managed-network';
            return (
              <ResourceItem
                href={hideLink ? undefined : item.data.link}
                image={item.data.image}
                title={item.data.name}
                description={item.data.description}
                linkText={hideLink ? undefined : 'Learn more'}
                imageSize='medium'
                index={index}
                target={hideLink ? undefined : '_blank'}
                rel={hideLink ? undefined : 'noopener noreferrer'}
              />
            );
          })}
        </div>
      </section>

      <section class='mb-32'>
        <SectionHeader title='Pre-Production Tools' subtitle='Vectorworks • Blender • Mapping Matter' accentColor='secondary' />
        <div class='grid md:grid-cols-2 gap-6 md:gap-12'>
          {techStack.map((tech, index) => (
            <ResourceItem
              href={tech.data.link}
              image={tech.data.image}
              title={tech.data.name}
              description={tech.data.description}
              linkText='Learn more'
              imageSize='small'
              index={index}
              target='_blank'
              rel='noopener noreferrer'
            />
          ))}
        </div>
      </section>

      <!-- CERTIFICATIONS -->
      <section class='mb-16'>
        <SectionHeader
          title='Certifications'
          subtitle='Professional qualifications'
          accentColor='secondary'
        />
        <div class='grid md:grid-cols-3 gap-6'>
          <div class='group border border-border rounded-3xl p-8 hover:border-primary transition-all duration-300'>
            <div class='text-4xl mb-4'>🎫</div>
            <h3 class='text-xl font-semibold mb-2'>disguise Certified Operator</h3>
            <p class='text-sm text-muted-foreground'>Official certification for disguise (d3) media server – 7+ years of professional use.</p>
          </div>

          <div class='group border border-border rounded-3xl p-8 hover:border-primary transition-all duration-300'>
            <div class='text-4xl mb-4'>📦</div>
            <h3 class='text-xl font-semibold mb-2'>Pixera Certified</h3>
            <p class='text-sm text-muted-foreground'>Certified specialist in Pixera media server platform for complex shows and virtual production.</p>
          </div>

          <div class='group border border-border rounded-3xl p-8 hover:border-primary transition-all duration-300'>
            <div class='text-4xl mb-4'>📐</div>
            <h3 class='text-xl font-semibold mb-2'>Vectorworks Core Certified</h3>
            <p class='text-sm text-muted-foreground'>Certified in 3D design and planning for LED screens, stages and projection mapping.</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>