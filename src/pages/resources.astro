---
import { Image } from 'astro:assets';
import { siteConfig } from '@/config';
---

<section class="py-20">
  <div class="container-fluid max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-6xl font-bold tracking-tighter mb-4">Technical Arsenal</h1>
      <p class="text-2xl text-muted-foreground">Konstantin Laptev • Video Technical Manager &amp; Media Server Specialist</p>
      <p class="mt-4 max-w-2xl mx-auto text-lg">18+ years delivering immersive visual experiences for F1, FIFA World Cup, MDL Soundstorm and major projection-mapping events worldwide.</p>
    </div>

    <!-- SKILLS CATEGORIES – exactly as you asked -->
    <div class="grid md:grid-cols-2 gap-12">

      <!-- 1. Media Servers -->
      <div>
        <h2 class="text-3xl font-semibold mb-6 flex items-center gap-3">
          <span class="text-4xl">🎥</span> Media Servers
        </h2>
        <ul class="space-y-4 text-lg">
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> <strong>disguise (d3)</strong> — 7+ years, Certified Operator</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> <strong>Pixera</strong> — Certified</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> <strong>Resolume Arena</strong></li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> <strong>MadMapper</strong></li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> <strong>Mapping Matter</strong></li>
        </ul>
      </div>

      <!-- 2. Projection & Mapping -->
      <div>
        <h2 class="text-3xl font-semibold mb-6 flex items-center gap-3">
          <span class="text-4xl">🗺️</span> Projection &amp; Mapping
        </h2>
        <ul class="space-y-4 text-lg">
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> Projection mapping (study → onsite execution)</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> LED screen planning &amp; execution</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> xR technologies &amp; virtual production</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> Vectorworks (Core Certified), Blender</li>
        </ul>
      </div>

      <!-- 3. Hardware & Broadcast Equipment -->
      <div>
        <h2 class="text-3xl font-semibold mb-6 flex items-center gap-3">
          <span class="text-4xl">📺</span> Hardware &amp; Broadcast Equipment
        </h2>
        <ul class="space-y-4 text-lg">
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> Barco E2, Analog Way Aquilon, Ross Ultrix</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> Panasonic &amp; Christie projectors</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> NovaStar LED control systems</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> stYpe RedSpy tracking</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> Broadcast cameras &amp; vision mixers</li>
        </ul>
      </div>

      <!-- 4. Creative Software -->
      <div>
        <h2 class="text-3xl font-semibold mb-6 flex items-center gap-3">
          <span class="text-4xl">✂️</span> Creative Software
        </h2>
        <ul class="space-y-4 text-lg">
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> Adobe Suite (After Effects, Premiere Pro)</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> Final Cut Pro</li>
          <li class="flex items-start gap-3"><span class="text-primary font-mono text-xl">•</span> Motion design &amp; VJ-ing</li>
        </ul>
      </div>

    </div>

    <!-- Certifications -->
    <div class="mt-20 border-t border-border pt-12">
      <h2 class="text-3xl font-semibold mb-8 text-center">Certifications</h2>
      <div class="flex flex-wrap justify-center gap-x-12 gap-y-6 text-xl">
        <div class="flex items-center gap-3">✅ disguise Certified Operator</div>
        <div class="flex items-center gap-3">✅ Pixera Certified</div>
        <div class="flex items-center gap-3">✅ Vectorworks Core Certified</div>
      </div>
    </div>

    <!-- Quick Resume Summary -->
    <div class="mt-20 text-center text-sm text-muted-foreground border border-border rounded-3xl p-8 max-w-2xl mx-auto">
      18 years live production • F1 Grand Prix • FIFA World Cup • MDL Soundstorm • ONE Zabeel projection (230 m) • 1.3 million visitors events
    </div>

  </div>
</section>