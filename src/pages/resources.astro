---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/shared/SectionHeader.astro';
import ResourceItem from '@/components/shared/ResourceItem.astro';

const currentBooks = await getCollection('books');
const techStack = await getCollection('techStack');
const desktopSetup = await getCollection('desktopSetup');
---

<Layout
  title='Technical Toolkit – Konstantin Laptev'
  description='The media servers, projectors, LED processors, vision mixers and pre-production software behind 18 years of large-scale live production — plus disguise, Pixera and Vectorworks certifications.'
  ogTitle='Technical Toolkit – Konstantin Laptev'
  ogDescription='Media servers, projection and broadcast hardware, and the pre-production software behind the shows.'
>
  <div class='relative'>
    <div class='container-fluid py-16 md:py-20 relative'>
      <div class='mb-20 text-center space-y-6'>
        <div class='inline-block'>
          <span
            class='text-xs uppercase tracking-widest text-primary font-bold px-4 py-2 rounded-full bg-primary/10 border border-primary/20 backdrop-blur-sm'
          >
            Toolkit
          </span>
        </div>
        <h1
          class='text-3xl md:text-4xl font-semibold text-foreground leading-tight tracking-tight first-letter-color'
        >
          Technical Toolkit<br />
          <span class='text-secondary'>Media Servers & Live Production</span>
        </h1>
        <p
          class='text-lg md:text-xl text-muted-foreground font-light max-w-3xl mx-auto leading-relaxed'
        >
          The hardware and software I work with day to day — and the certifications behind them.
        </p>
      </div>

      <section class='mb-32'>
        <SectionHeader title='Media Servers' subtitle='disguise • Pixera • Resolume • MadMapper' />
        <div class='grid md:grid-cols-2 gap-6 md:gap-12'>
          {currentBooks.map((book, index) => (
            <ResourceItem
              href={book.data.link}
              image={book.data.image}
              title={book.data.title}
              subtitle={book.data.author}
              description={book.data.description}
              linkText='Learn more'
              imageSize='medium'
              index={index}
            />
          ))}
        </div>
      </section>

      <section class='mb-32'>
        <SectionHeader title='Hardware & Broadcast Equipment' subtitle='Projectors • Vision Mixers • LED Processors • Broadcast Systems' />
        <div class='grid md:grid-cols-2 gap-6 md:gap-12'>
          {desktopSetup.map((item, index) => {
            const hideLink = item.id === 'broadcast-cameras' || item.id === 'managed-network';
            return (
              <ResourceItem
                href={hideLink ? undefined : item.data.link}
                image={item.data.image}
                title={item.data.name}
                description={item.data.description}
                linkText={hideLink ? undefined : 'Learn more'}
                imageSize='medium'
                index={index}
                target={hideLink ? undefined : '_blank'}
                rel={hideLink ? undefined : 'noopener noreferrer'}
              />
            );
          })}
        </div>
      </section>

      <section class='mb-32'>
        <SectionHeader title='Pre-Production Tools' subtitle='Vectorworks • Blender • Mapping Matter' accentColor='secondary' />
        <div class='grid md:grid-cols-2 gap-6 md:gap-12'>
          {techStack.map((tech, index) => (
            <ResourceItem
              href={tech.data.link}
              image={tech.data.image}
              title={tech.data.name}
              description={tech.data.description}
              linkText='Learn more'
              imageSize='small'
              index={index}
              target='_blank'
              rel='noopener noreferrer'
            />
          ))}
        </div>
      </section>

      <!-- CERTIFICATIONS -->
      <section class='mb-16'>
        <SectionHeader
          title='Certifications'
          subtitle='Vectorworks • disguise • Pixera'
          accentColor='secondary'
        />
        <div class='grid md:grid-cols-3 gap-6'>
          <div class='group border border-border rounded-3xl p-8 hover:border-primary transition-all duration-300'>
            <img src='/logos/Certs/Vectorworks_2025_Core_Certification.png' alt='Vectorworks Core Certified' class='w-24 h-24 mx-auto mb-6 object-contain' />
            <h3 class='text-xl font-semibold mb-2 text-center'>Vectorworks Core Certified</h3>
            <p class='text-sm text-muted-foreground text-center'>3D design and planning for LED screens, stage builds and projection studies.</p>
          </div>

          <div class='group border border-border rounded-3xl p-8 hover:border-primary transition-all duration-300'>
            <img src='/logos/Certs/disguise.png' alt='disguise Certified Operator' class='w-24 h-24 mx-auto mb-6 object-contain' />
            <h3 class='text-xl font-semibold mb-2 text-center'>disguise Certified Operator</h3>
            <p class='text-sm text-muted-foreground text-center'>Official operator certification for disguise (d3) — 7+ years running it on live shows.</p>
          </div>

          <div class='group border border-border rounded-3xl p-8 hover:border-primary transition-all duration-300'>
            <img src='/logos/Certs/pixera.png' alt='Pixera Certified' class='w-24 h-24 mx-auto mb-6 object-contain' />
            <h3 class='text-xl font-semibold mb-2 text-center'>Pixera Certified</h3>
            <p class='text-sm text-muted-foreground text-center'>Certified on the Pixera platform for complex shows and virtual production.</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>