---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title='Resources – Konstantin Laptev'
  description='Technical arsenal, media servers, projection mapping and broadcast equipment used in F1, FIFA World Cup and major events.'
>
  <div class="relative">
    <div class="container-fluid py-16 md:py-20 relative">
      <div class="mb-20 text-center space-y-6">
        <div class="inline-block">
          <span class="text-xs uppercase tracking-widest text-primary font-bold px-4 py-2 rounded-full bg-primary/10 border border-primary/20 backdrop-blur-sm">
            My Arsenal
          </span>
        </div>
        <h1 class="text-3xl md:text-4xl font-semibold text-foreground leading-tight tracking-tight">
          Tools &amp; Resources<br />
          <span class="text-secondary">I Use Daily</span>
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground font-light max-w-3xl mx-auto leading-relaxed">
          18+ years of live production • disguise • Pixera • projection mapping • broadcast hardware
        </p>
      </div>

      <!-- Current Reading → заменяем на Media Servers (с миниатюрами в стиле шаблона) -->
      <div class="mb-20">
        <h2 class="text-3xl font-semibold mb-8">Media Servers</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="border border-border rounded-3xl p-6 hover:border-primary transition-colors group">
            <div class="h-48 bg-secondary/30 rounded-2xl mb-4 flex items-center justify-center text-6xl">🎥</div>
            <h3 class="font-semibold text-xl mb-1">disguise (d3)</h3>
            <p class="text-muted-foreground text-sm mb-4">7+ years • Certified Operator</p>
            <a href="https://www.disguise.one" target="_blank" class="text-primary hover:underline text-sm flex items-center gap-1">Learn more →</a>
          </div>
          <div class="border border-border rounded-3xl p-6 hover:border-primary transition-colors group">
            <div class="h-48 bg-secondary/30 rounded-2xl mb-4 flex items-center justify-center text-6xl">📦</div>
            <h3 class="font-semibold text-xl mb-1">Pixera</h3>
            <p class="text-muted-foreground text-sm mb-4">Certified</p>
            <a href="https://www.pixera.one" target="_blank" class="text-primary hover:underline text-sm flex items-center gap-1">Learn more →</a>
          </div>
          <div class="border border-border rounded-3xl p-6 hover:border-primary transition-colors group">
            <div class="h-48 bg-secondary/30 rounded-2xl mb-4 flex items-center justify-center text-6xl">🌀</div>
            <h3 class="font-semibold text-xl mb-1">Resolume Arena</h3>
            <p class="text-muted-foreground text-sm mb-4">Real-time video mixing</p>
          </div>
        </div>
      </div>

      <!-- My Desk Setup → Hardware & Broadcast Equipment -->
      <div class="mb-20">
        <h2 class="text-3xl font-semibold mb-8">Hardware &amp; Broadcast Equipment</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="border border-border rounded-3xl p-6 hover:border-primary transition-colors group">
            <div class="h-48 bg-secondary/30 rounded-2xl mb-4 flex items-center justify-center text-6xl">📺</div>
            <h3 class="font-semibold text-xl mb-1">Barco E2 • Analog Way Aquilon • Ross Ultrix</h3>
            <p class="text-muted-foreground">Vision mixers &amp; processors</p>
          </div>
          <div class="border border-border rounded-3xl p-6 hover:border-primary transition-colors group">
            <div class="h-48 bg-secondary/30 rounded-2xl mb-4 flex items-center justify-center text-6xl">🔦</div>
            <h3 class="font-semibold text-xl mb-1">Panasonic &amp; Christie projectors</h3>
            <p class="text-muted-foreground">Projection mapping hardware</p>
          </div>
          <div class="border border-border rounded-3xl p-6 hover:border-primary transition-colors group">
            <div class="h-48 bg-secondary/30 rounded-2xl mb-4 flex items-center justify-center text-6xl">📡</div>
            <h3 class="font-semibold text-xl mb-1">NovaStar LED • stYpe RedSpy</h3>
            <p class="text-muted-foreground">LED control &amp; tracking</p>
          </div>
        </div>
      </div>

      <!-- Tech Stack → Projection & Mapping + Creative Software -->
      <div class="mb-20">
        <h2 class="text-3xl font-semibold mb-8">Projection, Mapping &amp; Creative Software</h2>
        <div class="flex flex-wrap gap-3">
          <span class="px-5 py-2 bg-secondary/70 text-foreground rounded-3xl text-sm font-medium">Projection mapping (study → onsite)</span>
          <span class="px-5 py-2 bg-secondary/70 text-foreground rounded-3xl text-sm font-medium">LED screen planning</span>
          <span class="px-5 py-2 bg-secondary/70 text-foreground rounded-3xl text-sm font-medium">xR technologies</span>
          <span class="px-5 py-2 bg-secondary/70 text-foreground rounded-3xl text-sm font-medium">Vectorworks (Core Certified)</span>
          <span class="px-5 py-2 bg-secondary/70 text-foreground rounded-3xl text-sm font-medium">Adobe After Effects</span>
          <span class="px-5 py-2 bg-secondary/70 text-foreground rounded-3xl text-sm font-medium">Resolume Arena</span>
          <span class="px-5 py-2 bg-secondary/70 text-foreground rounded-3xl text-sm font-medium">MadMapper</span>
          <span class="px-5 py-2 bg-secondary/70 text-foreground rounded-3xl text-sm font-medium">Final Cut Pro</span>
        </div>
      </div>

      <!-- Certifications & Notable Projects (с ссылками) -->
      <div>
        <h2 class="text-3xl font-semibold mb-8">Certifications &amp; Notable Projects</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="border border-border rounded-3xl p-8 hover:border-primary transition-colors">
            <h3 class="text-2xl font-semibold mb-2">disguise Certified Operator</h3>
            <a href="https://www.disguise.one/en/insights/news/oneonly-celebrates-landmark-hotel-launch-record-breaking-projection-powered-disguise" target="_blank" class="text-primary hover:underline">ONE Zabeel Opening →</a>
          </div>
          <div class="border border-border rounded-3xl p-8 hover:border-primary transition-colors">
            <h3 class="text-2xl font-semibold mb-2">Pixera Certified</h3>
            <a href="https://tinyurl.com/mediapro-soundstorm-2025" target="_blank" class="text-primary hover:underline">MDL Soundstorm 2023–2025 →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>